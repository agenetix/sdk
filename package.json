{
  "name": "@agenetix/sdk",
  "version": "1.0.1",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "MCP Stack telemetry SDK for MCP servers - track tool invocations, errors, and performance",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcpstack",
    "mcp",
    "model-context-protocol",
    "telemetry",
    "observability",
    "logging",
    "ai",
    "llm",
    "tools",
    "analytics"
  ],
  "author": "MCP Stack <hello@mcpstack.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenetix/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/agenetix/sdk/issues"
  },
  "homepage": "https://mcpstack.com",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  }
}
